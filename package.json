{
  "name": "quickprint-qr",
  "version": "0.1.0",
  "private": true,
  "description": "QuickPrint QR - soumission securisee de documents PDF par QR Code et gestion d'impression",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev:frontend": "npm run dev --workspace @quickprint/frontend",
    "dev:backend": "npm run start:dev --workspace @quickprint/backend",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  }
}
