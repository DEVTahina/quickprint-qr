# Environnement d'execution
NODE_ENV=development
PORT=3000

# Origine autorisee par CORS (plusieurs URLs separees par une virgule)
# Liste separee par des virgules des origines autorisees par CORS.
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173

# Projet Supabase - valeurs fictives, jamais versionnees
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Taille maximale d'un PDF (octets, maximum 20971520 = 20 MiB)
MAX_PDF_SIZE_BYTES=20971520

# Duree de validite d'une autorisation d'envoi (secondes, 60 a 3600)
UPLOAD_INTENT_TTL_SECONDS=900
